{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "little-india-brickfields-guide",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-08-11",
  "observability": {
    "enabled": true
  },
  "main": "src/worker.js"
}
